# Copie para .env e preencha. O .env nunca vai para o Git.

# local ou production (em production o seed de demonstração fica bloqueado)
APP_ENV=local
APP_DEBUG=false

# Endereço do site (o Angular). Usado nos links dos e-mails.
APP_URL=http://localhost:4200

# mysql (padrão) ou sqlite
DB_DRIVER=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=garagehub
DB_USERNAME=garagehub
DB_PASSWORD=

# Endereços do front que podem chamar a API, separados por vírgula
CORS_ORIGINS=http://localhost:4200

# Catálogo FIPE (Parallelum). Sem token: 1000 consultas por dia.
FIPE_URL=https://fipe.parallelum.com.br/api/v2
FIPE_TOKEN=

# Fotos dos carros: pasta no disco e endereço público dela
UPLOADS_DIR=
UPLOADS_URL=/uploads

# E-mail (redefinição de senha). Sem MAIL_DRIVER=smtp, os e-mails são gravados em storage/mail.
# MAIL_ENCRYPTION: tls (porta 587), ssl (porta 465) ou nenhuma
MAIL_DRIVER=
MAIL_HOST=
MAIL_PORT=587
MAIL_ENCRYPTION=tls
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME=Octane

# Quantos dias de backup do banco guardar (scripts/backup.php)
BACKUP_DIAS=14
