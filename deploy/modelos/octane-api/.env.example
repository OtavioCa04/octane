# Configuração de produção. Renomeie para .env e troque tudo que está entre < >.
# Este arquivo tem senhas: ele fica em octane-api, nunca em public_html.

APP_ENV=production
APP_DEBUG=false
APP_URL=https://<seu-dominio>

DB_DRIVER=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=<nome-do-banco>
DB_USERNAME=<usuario-do-banco>
DB_PASSWORD=<senha-do-banco>

# Mesmo endereço do APP_URL
CORS_ORIGINS=https://<seu-dominio>

FIPE_URL=https://fipe.parallelum.com.br/api/v2
FIPE_TOKEN=

# Caminho completo da pasta uploads dentro de public_html (o painel da hospedagem mostra o caminho)
UPLOADS_DIR=/home/<usuario>/public_html/uploads
UPLOADS_URL=/uploads

# E-mail que manda a redefinição de senha. Na Hostinger/Locaweb: crie uma conta de e-mail no painel
# (ex.: nao-responda@seu-dominio) e use o SMTP dela. No Brevo: smtp-relay.brevo.com, porta 587.
MAIL_DRIVER=smtp
MAIL_HOST=<smtp.seu-provedor>
MAIL_PORT=587
MAIL_ENCRYPTION=tls
MAIL_USERNAME=<usuario-smtp>
MAIL_PASSWORD=<senha-smtp>
MAIL_FROM_ADDRESS=<nao-responda@seu-dominio>
MAIL_FROM_NAME=Octane

BACKUP_DIAS=14
